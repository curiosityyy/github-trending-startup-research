[Unit]
Description=Startup Radar static website
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/project/github-trending-startup-research
ExecStart=/usr/bin/python3 -m http.server 4173 --bind 127.0.0.1 --directory /home/ec2-user/project/github-trending-startup-research/dist
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
